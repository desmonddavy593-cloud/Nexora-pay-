# NODE_ENV=production interdit SIMU et exige un JWT_SECRET d'au moins 32 caractères.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora_pay
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
FRAIS_TAUX=0.01
FRAIS_MINIMUM=100
EBILLING_BASE_URL=https://lab.billing-easy.net
EBILLING_CLIENT_ID=lab-client-id
EBILLING_CLIENT_SECRET=lab-client-secret
EBILLING_TOKEN_URL=https://lab.billing-easy.net/oauth/token
EBILLING_CALLBACK_URL=https://example.invalid/api/webhooks/ebilling?token=replace-me
EBILLING_WEBHOOK_SECRET=replace-with-a-private-webhook-secret
# TODO: renseigner la valeur exacte communiquée par Digitech.
EBILLING_PAID_STATE=replace-with-ebilling-paid-state
SHAP_ENABLED=false
SHAP_BASE_URL=https://test.billing-easy.net/shap/api/v1/merchant
SHAP_API_ID=lab-api-id
SHAP_API_SECRET=lab-api-secret
